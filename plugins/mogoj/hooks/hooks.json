{
  "description": "Automatic local Mogoj recall and durable Codex checkpoints",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/run.cjs\" session-start",
            "statusMessage": "Loading local Mogoj memory",
            "timeout": 20
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/run.cjs\" prompt",
            "statusMessage": "Recalling relevant local memory",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/run.cjs\" stop",
            "statusMessage": "Saving durable project memory",
            "timeout": 10
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/run.cjs\" pre-compact",
            "statusMessage": "Checkpointing local memory",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/run.cjs\" session-end",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
