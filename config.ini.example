# Mogoj configuration — optional. Delete this file to use defaults.
# All values below match the hardcoded defaults.

[paths]
scan_dirs = docs,data/sessions

[index]
max_keywords_per_doc = 20
min_keyword_length = 3
fingerprint_length = 12
hash_length = 8

[ram]
max_lines = 35
max_bytes = 1536
auto_archive = true

[search]
context_lines = 1
max_results = 50

[health]
stale_days = 30
